# ---------------------------------------------------------------
# FailureAI configuration. Copy to .env (or set in your host's UI).
# ZERO config needed: without any key the app runs on the built-in
# Local Engine and still produces a full, usable campaign kit.
# ---------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
PUBLIC_SITE_URL=https://your-domain.com   # used for canonical / sitemap / OG tags

# --- Live AI (pick ONE, or let users paste their own key in Settings) ---
# OpenAI or any OpenAI-compatible gateway (Groq, Together, OpenRouter, Ollama...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Optional live web research for client data (Tavily / Serper / Brave) ---
SEARCH_PROVIDER=tavily            # tavily | serper | brave | none
SEARCH_API_KEY=

# --- Optional server-side image generation (OpenAI Images API) ---
# If empty, Creative Studio renders images via the free Pollinations URL
# and always gives you production-ready prompts for Midjourney / DALL-E / SDXL.
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# --- Safety ---
RATE_LIMIT_PER_MIN=40
REQUEST_TIMEOUT_MS=45000

# ---------------------------------------------------------------- WhatsApp
# Meta → App → WhatsApp → API setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Must match the "Verify token" you type in the Meta webhook dialog.
WHATSAPP_VERIFY_TOKEN=doodhwala-verify
# Optional but recommended: enables X-Hub-Signature-256 verification.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------- Supabase
# Optional. Without these the app uses a local JSON store in .data/db.json.
# Use the service-role key (server side only) after running db/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Business
# Timezone used for "today", delivery dates and cut-off.
BUSINESS_TZ=Asia/Kolkata
# Override the local demo database path if needed.
# LOCAL_DB_PATH=/absolute/path/db.json
